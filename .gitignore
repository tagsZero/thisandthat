# GitHub: runtime files and explicit current maintenance documents only.
/*
!/.gitignore
!/.env.example
!/README.md
!/app.py
!/requirements.txt
!/requirements-khtp.txt
!/requirements-khtp-model.txt
# Required constraints for the model dependency file.
!/requirements-khtp-tools.txt
!/tci_web/
!/khtp_web/
!/templates/
!/static/
!/data/
!/docs/

# Explicit current manuals, rules and contracts. Local research/history stays excluded.
/docs/*
!/docs/index.md
!/docs/manual-index.md
!/docs/manual/
!/docs/ssot/
!/docs/changes/
*.md
!/AGENTS.md
!/SSOT.md
!/README.md
!/docs/index.md
!/docs/manual-index.md
!/docs/manual/*.md
!/docs/ssot/*.md
!/docs/changes/*.md
!/static/fonts/README.md

# Explicit runtime seed data only.
/data/*
!/data/interpretations.json
!/data/type_interpretations.json
!/data/khtp/
/data/khtp/*
!/data/khtp/observations-v1.json

# Secrets, environments, caches and generated files.
.env
.env.*
!/.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
node_modules/
.idea/
.vscode/
*.log
*.sqlite
*.sqlite3
*.db

# Exclude tests, reports and backup copies inside runtime folders too.
tests/
test_*.py
*_test.py
reports/
backups/
backup/
archive/
archives/
*.bak
*.backup
*.old
*.orig
*.rej
*~
Thumbs.db
.DS_Store
