# Copy to .env and replace the connection values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tci
DB_USER=tci_app
DB_PASSWORD="CHANGE_ME"
# SECRET_KEY is generated in .env on first startup.
# Public registration is enabled by default, per the selected registration policy.
# A configured invite code is required even when REGISTRATION_OPEN is true.
# REGISTRATION_INVITE_CODE="SET_A_PRIVATE_BETA_CODE"
# REGISTRATION_OPEN=1
